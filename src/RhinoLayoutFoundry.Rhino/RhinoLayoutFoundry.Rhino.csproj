<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RhinoLayoutFoundry.Rhino</RootNamespace>
    <AssemblyName>RhinoLayoutFoundry</AssemblyName>
    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.1.0</Version>
    <Title>Rhino Layout Foundry</Title>
    <Company>Rhino Layout Foundry contributors</Company>
    <Description>Batch layout management for Rhino 8.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RhinoLayoutFoundry.Core\RhinoLayoutFoundry.Core.csproj" />
    <ProjectReference Include="..\RhinoLayoutFoundry.Extensibility\RhinoLayoutFoundry.Extensibility.csproj" />
    <ProjectReference Include="..\RhinoLayoutFoundry.UI\RhinoLayoutFoundry.UI.csproj" />
    <PackageReference Include="RhinoCommon" ExcludeAssets="runtime" />
    <EmbeddedResource Include="Resources\LayoutFoundryMark.svg"
                      LogicalName="RhinoLayoutFoundry.Rhino.Resources.LayoutFoundryMark.svg" />
  </ItemGroup>
</Project>
