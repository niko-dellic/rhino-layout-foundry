<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RhinoLayoutFoundry.UI</RootNamespace>
    <AssemblyName>RhinoLayoutFoundry.UI</AssemblyName>
    <RhinoMacResources Condition="'$(RhinoMacResources)' == ''">/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources</RhinoMacResources>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and Exists('$(RhinoMacResources)/Microsoft.macOS.dll') and Exists('$(RhinoMacResources)/Eto.macOS.dll')">
    <DefineConstants>$(DefineConstants);FOUNDRY_MACOS_NATIVE_GESTURES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RhinoLayoutFoundry.Core\RhinoLayoutFoundry.Core.csproj" />
    <ProjectReference Include="..\RhinoLayoutFoundry.Extensibility\RhinoLayoutFoundry.Extensibility.csproj" />
    <PackageReference Include="RhinoCommon" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and Exists('$(RhinoMacResources)/Microsoft.macOS.dll') and Exists('$(RhinoMacResources)/Eto.macOS.dll')">
    <Reference Include="Eto.macOS">
      <HintPath>$(RhinoMacResources)/Eto.macOS.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.macOS">
      <HintPath>$(RhinoMacResources)/Microsoft.macOS.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
